@model Freecrmlance.Web.Models.Quotes.QuoteFormViewModel
<div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4"></div>
<div class="quote-form-identity">
    <label asp-for="Number" class="form-label">Numéro du devis</label>
    <input asp-for="Number" class="form-control" placeholder="DEV-001" />
    <span asp-validation-for="Number" class="text-danger small"></span>
</div>
<div class="quote-form-section-header">
    <div><h2 class="h5 mb-1">Prestations</h2><p class="text-body-secondary small mb-0">Détaillez les prestations et leur prix unitaire.</p></div>
    <button class="btn btn-sm btn-outline-primary" type="button" id="addQuoteLine">+ Ajouter une ligne</button>
</div>
<div id="quoteLines">
@for (var i = 0; i < Model.Lines.Count; i++)
{
    <div class="quote-line">
        <div class="row g-3 align-items-end">
            <div class="col-md-6"><label class="form-label">Description</label><input class="form-control" name="Lines[@i].Description" value="@Model.Lines[i].Description" required maxlength="500" /></div>
            <div class="col-md-2"><label class="form-label">Quantité</label><input class="form-control" name="Lines[@i].Quantity" value="@Model.Lines[i].Quantity" type="number" min="0.0001" step="0.0001" required /></div>
            <div class="col-md-3"><label class="form-label">Prix unitaire HT</label><input class="form-control" name="Lines[@i].UnitPrice" value="@Model.Lines[i].UnitPrice" type="number" min="0" step="0.01" required /></div>
            <div class="col-md-1"><button class="btn btn-outline-danger remove-quote-line quote-line-remove" type="button" aria-label="Supprimer la ligne">×</button></div>
        </div>
    </div>
}
</div>
<script>
(() => {
    const container = document.getElementById("quoteLines");
    const renumber = () => [...container.querySelectorAll(".quote-line")].forEach((row, index) => {
        row.querySelectorAll("[name]").forEach(input => input.name = input.name.replace(/Lines\[\d+\]/, "Lines[" + index + "]"));
    });
    document.getElementById("addQuoteLine").addEventListener("click", () => {
        const index = container.querySelectorAll(".quote-line").length;
        const row = document.createElement("div");
        row.className = "quote-line";
        row.innerHTML = '<div class="row g-3 align-items-end">' +
            '<div class="col-md-6"><label class="form-label">Description</label><input class="form-control" name="Lines[' + index + '].Description" required maxlength="500" /></div>' +
            '<div class="col-md-2"><label class="form-label">Quantité</label><input class="form-control" name="Lines[' + index + '].Quantity" value="1" type="number" min="0.0001" step="0.0001" required /></div>' +
            '<div class="col-md-3"><label class="form-label">Prix unitaire HT</label><input class="form-control" name="Lines[' + index + '].UnitPrice" value="0" type="number" min="0" step="0.01" required /></div>' +
            '<div class="col-md-1"><button class="btn btn-outline-danger remove-quote-line quote-line-remove" type="button" aria-label="Supprimer la ligne">×</button></div></div>';
        container.appendChild(row);
    });
    container.addEventListener("click", event => {
        if (!event.target.classList.contains("remove-quote-line")) return;
        if (container.querySelectorAll(".quote-line").length === 1) return;
        event.target.closest(".quote-line").remove();
        renumber();
    });
})();
</script>
