@model Freecrmlance.Web.Models.Quotes.QuoteDetailsViewModel
@{
    var quote = Model.Quote;
    ViewData["Title"] = quote.Number;
    var customerId = ViewContext.RouteData.Values["customerId"];
    var statusLabel = quote.Status switch {
        Freecrmlance.Domain.Crm.QuoteStatus.Draft => "Brouillon",
        Freecrmlance.Domain.Crm.QuoteStatus.Sent => "Envoyé",
        Freecrmlance.Domain.Crm.QuoteStatus.Accepted => "Accepté",
        Freecrmlance.Domain.Crm.QuoteStatus.Rejected => "Refusé",
        _ => quote.Status.ToString()
    };
    var statusClass = quote.Status switch {
        Freecrmlance.Domain.Crm.QuoteStatus.Accepted => "status-success",
        Freecrmlance.Domain.Crm.QuoteStatus.Rejected => "status-danger",
        Freecrmlance.Domain.Crm.QuoteStatus.Sent => "status-info",
        _ => "status-neutral"
    };
}
<div class="document-page">
    <div class="document-toolbar">
        <div>
            <a class="back-link" asp-controller="Customers" asp-action="Details" asp-route-id="@customerId">← Retour au client</a>
            <div class="d-flex align-items-center gap-2 mt-2"><h1>@quote.Number</h1><span class="status-pill @statusClass">@statusLabel</span></div>
            <p>Devis créé le @quote.CreatedAtUtc.ToString("dd MMMM yyyy")</p>
        </div>
        <div class="document-actions">
            <a class="btn btn-quiet" asp-action="Pdf" asp-route-customerId="@customerId" asp-route-quoteId="@quote.Id">Télécharger PDF</a>
            @if (quote.Status == Freecrmlance.Domain.Crm.QuoteStatus.Draft)
            {
                <a class="btn btn-quiet" asp-action="Edit" asp-route-customerId="@customerId" asp-route-quoteId="@quote.Id">Modifier</a>
                <form asp-action="Send" asp-route-customerId="@customerId" asp-route-quoteId="@quote.Id" method="post"><button class="btn btn-primary" type="submit">Marquer comme envoyé</button></form>
            }
            else if (quote.Status == Freecrmlance.Domain.Crm.QuoteStatus.Sent)
            {
                <form asp-action="Accept" asp-route-customerId="@customerId" asp-route-quoteId="@quote.Id" method="post"><button class="btn btn-success" type="submit">Accepter</button></form>
                <form asp-action="Reject" asp-route-customerId="@customerId" asp-route-quoteId="@quote.Id" method="post"><button class="btn btn-outline-danger" type="submit">Refuser</button></form>
            }
            else if (quote.Status == Freecrmlance.Domain.Crm.QuoteStatus.Accepted)
            {
                if (Model.SourceInvoice is null)
                { <a class="btn btn-primary" asp-controller="Invoices" asp-action="CreateFromQuote" asp-route-customerId="@customerId" asp-route-quoteId="@quote.Id">Créer la facture</a> }
                else
                { <a class="btn btn-primary" asp-controller="Invoices" asp-action="Details" asp-route-customerId="@customerId" asp-route-invoiceId="@Model.SourceInvoice.Id">Voir la facture</a> }
            }
        </div>
    </div>

    <article class="paper-card">
        <div class="paper-heading">
            <div><span class="eyebrow">Devis</span><strong>@quote.Number</strong></div>
            <div class="paper-total"><span>Total</span><strong>@quote.Total.ToString("C")</strong></div>
        </div>
        <div class="table-responsive">
            <table class="table document-table">
                <thead><tr><th>Prestation</th><th class="text-end">Qté</th><th class="text-end">Prix unitaire</th><th class="text-end">Total</th></tr></thead>
                <tbody>@foreach (var line in quote.Lines) { <tr><td><strong>@line.Description</strong></td><td class="text-end">@line.Quantity</td><td class="text-end">@line.UnitPrice.ToString("C")</td><td class="text-end fw-semibold">@line.Total.ToString("C")</td></tr> }</tbody>
            </table>
        </div>
        <div class="document-total"><span>Total du devis</span><strong>@quote.Total.ToString("C")</strong></div>
    </article>

    <section class="sharing-panel">
        <div>
            <span class="eyebrow">Espace client</span>
            <h2>Partage public</h2>
            <p>@(Model.ActiveShare is null ? "Créez un lien sécurisé pour permettre à votre client de consulter et répondre au devis." : "Ce devis est accessible à votre client via un lien sécurisé.")</p>
        </div>
        <div>
        @if (Model.ActiveShare is null)
        {
            <form asp-action="Share" asp-route-customerId="@customerId" asp-route-quoteId="@quote.Id" method="post"><button class="btn btn-primary" type="submit">Créer un lien client</button></form>
        }
        else
        {
            <span class="status-pill status-success me-2">Lien actif</span>
            <form class="d-inline" asp-action="RevokeShare" asp-route-customerId="@customerId" asp-route-quoteId="@quote.Id" asp-route-shareId="@Model.ActiveShare.Id" method="post" onsubmit="return confirm('Révoquer ce lien public ?');"><button class="btn btn-quiet" type="submit">Révoquer</button></form>
        }
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.ShareUrl))
        {
            <div class="share-url"><input id="quote-share-url" value="@Model.ShareUrl" readonly /><button type="button" onclick="navigator.clipboard.writeText(document.getElementById('quote-share-url').value)">Copier</button></div>
        }
    </section>
</div>
