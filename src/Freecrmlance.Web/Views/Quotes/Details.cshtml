@model Freecrmlance.Application.Crm.QuoteDto
@{ ViewData["Title"] = Model.Number; var customerId = ViewContext.RouteData.Values["customerId"]; }
<div class="page-header d-flex justify-content-between align-items-start gap-3">
<div><a class="text-decoration-none small" asp-controller="Customers" asp-action="Details" asp-route-id="@customerId">← Customer</a><h1 class="h2 mt-2 mb-1">@Model.Number</h1><span class="badge text-bg-secondary">@Model.Status</span></div>
@if (Model.Status == Freecrmlance.Domain.Crm.QuoteStatus.Draft) { <a class="btn btn-primary" asp-action="Edit" asp-route-customerId="@customerId" asp-route-quoteId="@Model.Id">Edit draft</a> }
</div>
<div class="card shadow-sm border-0"><div class="card-body p-4">
<div class="table-responsive"><table class="table align-middle"><thead><tr><th>Description</th><th class="text-end">Quantity</th><th class="text-end">Unit price</th><th class="text-end">Total</th></tr></thead><tbody>
@foreach (var line in Model.Lines) { <tr><td>@line.Description</td><td class="text-end">@line.Quantity</td><td class="text-end">@line.UnitPrice.ToString("0.00")</td><td class="text-end">@line.Total.ToString("0.00")</td></tr> }
</tbody><tfoot><tr><th colspan="3" class="text-end">Total</th><th class="text-end">@Model.Total.ToString("0.00")</th></tr></tfoot></table></div>
<div class="text-body-secondary small">Created @Model.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC · Updated @Model.UpdatedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</div>
</div></div>
