@model Freecrmlance.Web.Models.WorkspaceSettings.WorkspaceLegalIdentityViewModel
@{ ViewData["Title"] = "Paramètres de l’entreprise"; }

<div class="page-header">
    <h1 class="h2 mb-1">Identité légale de l’entreprise</h1>
    <p class="text-body-secondary mb-0">Ces informations concernant @Model.WorkspaceName sont utilisées sur vos documents commerciaux.</p>
</div>
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
<div class="card form-card shadow-sm border-0"><div class="card-body p-4">
<form method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <h2 class="h5 mb-3">Entreprise</h2>
    <div class="row g-3">
        <div class="col-md-8"><label asp-for="LegalName" class="form-label">Raison sociale / nom légal</label><input asp-for="LegalName" class="form-control" /><span asp-validation-for="LegalName"></span></div>
        <div class="col-md-4"><label asp-for="LegalForm" class="form-label">Forme juridique</label><input asp-for="LegalForm" class="form-control" placeholder="EI, SASU, EURL…" /><span asp-validation-for="LegalForm"></span></div>
        <div class="col-md-4"><label asp-for="Siren" class="form-label">SIREN</label><input asp-for="Siren" class="form-control" inputmode="numeric" /><span asp-validation-for="Siren"></span></div>
        <div class="col-md-4"><label asp-for="Siret" class="form-label">SIRET</label><input asp-for="Siret" class="form-control" inputmode="numeric" /><span asp-validation-for="Siret"></span></div>
        <div class="col-md-4"><label asp-for="VatNumber" class="form-label">N° TVA intracommunautaire</label><input asp-for="VatNumber" class="form-control" /><span asp-validation-for="VatNumber"></span></div>
    </div>
    <h2 class="h5 mt-4">Adresse du siège</h2>
    <div class="row g-3">
        <div class="col-12"><label asp-for="AddressLine1" class="form-label">Adresse</label><input asp-for="AddressLine1" class="form-control" /><span asp-validation-for="AddressLine1"></span></div>
        <div class="col-12"><label asp-for="AddressLine2" class="form-label">Complément d’adresse</label><input asp-for="AddressLine2" class="form-control" /></div>
        <div class="col-md-3"><label asp-for="PostalCode" class="form-label">Code postal</label><input asp-for="PostalCode" class="form-control" /><span asp-validation-for="PostalCode"></span></div>
        <div class="col-md-6"><label asp-for="City" class="form-label">Ville</label><input asp-for="City" class="form-control" /><span asp-validation-for="City"></span></div>
        <div class="col-md-3"><label asp-for="CountryCode" class="form-label">Pays</label><input asp-for="CountryCode" class="form-control" placeholder="FR" /><span asp-validation-for="CountryCode"></span></div>
    </div>
    <h2 class="h5 mt-4">Coordonnées</h2>
    <div class="row g-3 mb-4">
        <div class="col-md-6"><label asp-for="ContactEmail" class="form-label">E-mail de contact</label><input asp-for="ContactEmail" class="form-control" /><span asp-validation-for="ContactEmail"></span></div>
        <div class="col-md-6"><label asp-for="ContactPhone" class="form-label">Téléphone</label><input asp-for="ContactPhone" class="form-control" /></div>
    </div>
    <div class="d-flex justify-content-end"><button class="btn btn-primary" type="submit">Enregistrer les paramètres</button></div>
</form>
</div></div>
