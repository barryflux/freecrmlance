@model Freecrmlance.Web.Models.Account.LoginViewModel
@{ ViewData["Title"] = "Login"; }

<h1>Login</h1>
<form asp-action="Login" method="post">
    <div asp-validation-summary="ModelOnly"></div>
    <div><label asp-for="Email"></label><input asp-for="Email" /><span asp-validation-for="Email"></span></div>
    <div><label asp-for="Password"></label><input asp-for="Password" /><span asp-validation-for="Password"></span></div>
    <button type="submit">Login</button>
</form>
