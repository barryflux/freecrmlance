@model Freecrmlance.Application.Billing.InvoiceDto
@{
    var displayReference = Model.Number ?? Model.DraftReference;
    ViewData["Title"] = displayReference;
    var customerId = ViewContext.RouteData.Values["customerId"];
    var issued = Model.Status == Freecrmlance.Domain.Billing.InvoiceStatus.Issued;
}
<div class="document-page">
    <div class="document-toolbar">
        <div>
            <a class="back-link" asp-controller="Customers" asp-action="Details" asp-route-id="@customerId">← Retour au client</a>
            <div class="d-flex align-items-center gap-2 mt-2"><h1>@displayReference</h1><span class="status-pill @(issued ? "status-success" : "status-neutral")">@(issued ? "Émise" : "Brouillon")</span></div>
            <p>@(issued && Model.IssueDate is not null ? $"Émise le {Model.IssueDate.Value:dd MMMM yyyy}" : $"Brouillon créé le {Model.CreatedAtUtc:dd MMMM yyyy}")</p>
        </div>
        <div class="document-actions">
            @if (!issued)
            {
                <a class="btn btn-quiet" asp-action="Edit" asp-route-customerId="@customerId" asp-route-invoiceId="@Model.Id">Modifier</a>
                <form method="post" asp-action="Issue" asp-route-customerId="@customerId" asp-route-invoiceId="@Model.Id"><button class="btn btn-primary" type="submit">Émettre la facture</button></form>
            }
            @if (Model.SourceQuoteId is not null)
            {
                <a class="btn btn-quiet" asp-controller="Quotes" asp-action="Details" asp-route-customerId="@customerId" asp-route-quoteId="@Model.SourceQuoteId">Voir le devis source</a>
            }
        </div>
    </div>

    @if (Context.Request.Query["issuanceError"] == "true")
    { <div class="alert alert-danger">La facture est incomplète. Vérifiez les identités légales, adresses, dates, conditions de paiement et informations de TVA.</div> }

    <article class="paper-card">
        <div class="paper-heading">
            <div><span class="eyebrow">Facture</span><strong>@displayReference</strong>@if (Model.Number is null) { <small>Référence provisoire</small> }</div>
            <div class="paper-total"><span>Total TTC</span><strong>@Model.TotalIncludingTax.ToString("C")</strong></div>
        </div>
        <div class="party-grid">
            <div><span>Émetteur</span><strong>@(Model.SellerLegalName ?? "Identité à compléter")</strong><p>@Model.SellerAddressLine1<br />@Model.SellerPostalCode @Model.SellerCity</p></div>
            <div><span>Client</span><strong>@(Model.CustomerLegalName ?? "Identité à compléter")</strong><p>@Model.CustomerAddressLine1<br />@Model.CustomerPostalCode @Model.CustomerCity</p></div>
        </div>
        <div class="table-responsive">
            <table class="table document-table">
                <thead><tr><th>Prestation</th><th class="text-end">Qté</th><th class="text-end">Prix HT</th><th class="text-end">TVA</th><th class="text-end">TTC</th></tr></thead>
                <tbody>@foreach (var line in Model.Lines) { <tr><td><strong>@line.Description</strong></td><td class="text-end">@line.Quantity</td><td class="text-end">@line.UnitPrice.ToString("C")</td><td class="text-end">@line.VatRate.ToString("0.##") %</td><td class="text-end fw-semibold">@line.TotalIncludingTax.ToString("C")</td></tr> }</tbody>
            </table>
        </div>
        <div class="totals-box">
            <div><span>Total HT</span><strong>@Model.TotalExcludingTax.ToString("C")</strong></div>
            <div><span>TVA</span><strong>@Model.TotalVat.ToString("C")</strong></div>
            <div class="grand-total"><span>Total TTC</span><strong>@Model.TotalIncludingTax.ToString("C")</strong></div>
        </div>
        <div class="invoice-meta">
            <div><span>Date de prestation</span><strong>@(Model.ServiceDate?.ToString("dd/MM/yyyy") ?? "—")</strong></div>
            <div><span>Échéance</span><strong>@(Model.DueDate?.ToString("dd/MM/yyyy") ?? "—")</strong></div>
            <div><span>Conditions de paiement</span><strong>@(Model.PaymentTerms ?? "—")</strong></div>
            <div><span>Référence commande</span><strong>@(Model.PurchaseOrderReference ?? "—")</strong></div>
        </div>
    </article>
</div>
