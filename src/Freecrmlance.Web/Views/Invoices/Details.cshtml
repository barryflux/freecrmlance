@model Freecrmlance.Application.Billing.InvoiceDto
@{
    var displayReference = Model.Number ?? Model.DraftReference;
    ViewData["Title"] = displayReference;
    var customerId = ViewContext.RouteData.Values["customerId"];
    var isDraft = Model.Status == Freecrmlance.Domain.Billing.InvoiceStatus.Draft;
}

<div class="page-header invoice-page-header">
    <div>
        <a class="text-decoration-none small" asp-controller="Customers" asp-action="Details" asp-route-id="@customerId" asp-fragment="invoices">← Factures du client</a>
        <div class="invoice-title-row">
            <h1 class="h2 mb-0">@displayReference</h1>
            <span class="status-badge @(isDraft ? "status-draft" : "status-issued")">@(isDraft ? "Brouillon" : "Émise")</span>
        </div>
        @if (isDraft)
        {
            <p class="text-body-secondary mb-0">Référence provisoire · le numéro définitif sera attribué à l’émission.</p>
        }
        else if (Model.IssueDate is not null)
        {
            <p class="text-body-secondary mb-0">Émise le @Model.IssueDate.Value.ToString("dd/MM/yyyy")</p>
        }
    </div>
    <div class="invoice-header-total">
        <span>Total TTC</span>
        <strong>@Model.TotalIncludingTax.ToString("C")</strong>
    </div>
</div>

<div class="invoice-action-bar">
    <div class="invoice-primary-actions">
        @if (isDraft)
        {
            <form method="post" asp-action="Issue" asp-route-customerId="@customerId" asp-route-invoiceId="@Model.Id">
                <button class="btn btn-primary" type="submit">Émettre la facture</button>
            </form>
            <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-customerId="@customerId" asp-route-invoiceId="@Model.Id">Modifier</a>
        }
    </div>
    @if (Model.SourceQuoteId is not null)
    {
        <a class="btn btn-outline-secondary" asp-controller="Quotes" asp-action="Details" asp-route-customerId="@customerId" asp-route-quoteId="@Model.SourceQuoteId">Voir le devis source</a>
    }
</div>

@if (Context.Request.Query["issuanceError"] == "true")
{
    <div class="alert alert-danger invoice-issuance-alert">
        <strong>La facture n’est pas prête à être émise.</strong>
        <div>Vérifiez les identités légales, les adresses, la date de prestation, les conditions de paiement et la TVA.</div>
    </div>
}

<section class="invoice-surface">
    <div class="invoice-surface-heading">
        <div><span class="customer-profile-kicker">Prestations</span><h2>Détail de la facture</h2></div>
        <span>@Model.Lines.Count ligne@(Model.Lines.Count > 1 ? "s" : "")</span>
    </div>
    <div class="table-responsive">
        <table class="table invoice-lines-table align-middle mb-0">
            <thead><tr><th>Description</th><th class="text-end">Quantité</th><th class="text-end">Prix unitaire HT</th><th class="text-end">TVA</th><th class="text-end">TTC</th></tr></thead>
            <tbody>
            @foreach (var line in Model.Lines)
            {
                <tr><td>@line.Description</td><td class="text-end">@line.Quantity</td><td class="text-end">@line.UnitPrice.ToString("C")</td><td class="text-end">@line.VatRate.ToString("0.##")% <span class="text-body-secondary">(@line.VatAmount.ToString("C"))</span></td><td class="text-end fw-semibold">@line.TotalIncludingTax.ToString("C")</td></tr>
            }
            </tbody>
        </table>
    </div>
    <div class="invoice-totals">
        <div><span>Total HT</span><strong>@Model.TotalExcludingTax.ToString("C")</strong></div>
        <div><span>TVA</span><strong>@Model.TotalVat.ToString("C")</strong></div>
        <div class="invoice-total-main"><span>Total TTC</span><strong>@Model.TotalIncludingTax.ToString("C")</strong></div>
    </div>
</section>

<div class="invoice-info-grid">
    <section class="invoice-info-card">
        <span class="customer-profile-kicker">Facturation</span>
        <h2>Conditions</h2>
        <dl class="customer-data-grid">
            <div><dt>Date de prestation</dt><dd>@(Model.ServiceDate?.ToString("dd/MM/yyyy") ?? "—")</dd></div>
            <div><dt>Date d’échéance</dt><dd>@(Model.DueDate?.ToString("dd/MM/yyyy") ?? "—")</dd></div>
            <div class="customer-data-wide"><dt>Conditions de paiement</dt><dd>@(Model.PaymentTerms ?? "—")</dd></div>
            <div><dt>Commande / référence</dt><dd>@(Model.PurchaseOrderReference ?? "—")</dd></div>
            <div><dt>Indemnité de recouvrement</dt><dd>@(Model.RecoveryCostIndemnity?.ToString("0.00 €") ?? "—")</dd></div>
            @if (!string.IsNullOrWhiteSpace(Model.VatExemptionMention))
            {
                <div class="customer-data-wide"><dt>Mention d’exonération de TVA</dt><dd>@Model.VatExemptionMention</dd></div>
            }
        </dl>
    </section>

    <section class="invoice-info-card">
        <span class="customer-profile-kicker">Instantané légal</span>
        <h2>Identités enregistrées</h2>
        <div class="invoice-identities">
            <div><span>Vendeur</span><strong>@(Model.SellerLegalName ?? "—")</strong><p>@Model.SellerAddressLine1 @Model.SellerAddressLine2<br />@Model.SellerPostalCode @Model.SellerCity @Model.SellerCountryCode</p></div>
            <div><span>Client</span><strong>@(Model.CustomerLegalName ?? "—")</strong><p>@Model.CustomerAddressLine1 @Model.CustomerAddressLine2<br />@Model.CustomerPostalCode @Model.CustomerCity @Model.CustomerCountryCode</p></div>
        </div>
    </section>
</div>

<div class="invoice-audit-note">Créée le @Model.CreatedAtUtc.ToString("dd/MM/yyyy à HH:mm") · modifiée le @Model.UpdatedAtUtc.ToString("dd/MM/yyyy à HH:mm")</div>
