@model Freecrmlance.Web.Models.Customers.CustomerDetailsViewModel
@{ ViewData["Title"] = Model.Customer.Name; }

<div class="page-header d-flex flex-column flex-sm-row justify-content-between align-items-sm-start gap-3">
    <div><a class="text-decoration-none small" asp-action="Index">← Customers</a><h1 class="h2 mt-2 mb-0">@Model.Customer.Name</h1></div>
    <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.Customer.Id">Edit customer</a>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-4">
        <h2 class="h5 mb-3">Customer information</h2>
        <div class="row g-3">
            <div class="col-md-6"><div class="text-body-secondary small">Email</div><div>@(Model.Customer.Email ?? "—")</div></div>
            <div class="col-md-6"><div class="text-body-secondary small">Phone</div><div>@(Model.Customer.Phone ?? "—")</div></div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 mb-0">Contacts <span class="badge text-bg-secondary">@Model.Contacts.Count</span></h2>
    <a class="btn btn-primary btn-sm" asp-action="CreateContact" asp-route-id="@Model.Customer.Id">Add contact</a>
</div>

@if (Model.Contacts.Count == 0)
{
    <div class="empty-state"><h3 class="h5">No contacts yet</h3><p class="text-body-secondary mb-3">Add the first person associated with this customer.</p><a class="btn btn-primary" asp-action="CreateContact" asp-route-id="@Model.Customer.Id">Add contact</a></div>
}
else
{
    <div class="row g-3">
    @foreach (var contact in Model.Contacts)
    {
        <div class="col-md-6 col-xl-4">
            <article class="card contact-card shadow-sm border-0">
                <div class="card-body">
                    <div class="d-flex justify-content-between gap-2 mb-3"><div><h3 class="h5 mb-1">@contact.Name</h3><span class="text-body-secondary small">@(contact.Role ?? "No role")</span></div></div>
                    <div class="small mb-1"><span class="text-body-secondary">Email:</span> @if (contact.Email is not null) { <a href="mailto:@contact.Email">@contact.Email</a> } else { <span>—</span> }</div>
                    <div class="small"><span class="text-body-secondary">Phone:</span> @if (contact.Phone is not null) { <a href="tel:@contact.Phone">@contact.Phone</a> } else { <span>—</span> }</div>
                </div>
                <div class="card-footer bg-transparent d-flex gap-2">
                    <button class="btn btn-sm btn-outline-secondary"
                            type="button"
                            data-bs-toggle="modal"
                            data-bs-target="#editContactModal"
                            data-contact-id="@contact.Id"
                            data-contact-name="@contact.Name"
                            data-contact-role="@contact.Role"
                            data-contact-email="@contact.Email"
                            data-contact-phone="@contact.Phone">Edit</button>
                    <button class="btn btn-sm btn-outline-danger"
                            type="button"
                            data-bs-toggle="modal"
                            data-bs-target="#deleteContactModal"
                            data-contact-id="@contact.Id"
                            data-contact-name="@contact.Name">Delete</button>
                </div>
            </article>
        </div>
    }
    </div>
}




<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mt-5 mb-3">
    <div><h2 class="h4 mb-1">Quotes <span class="badge text-bg-secondary">@Model.Quotes.Count</span></h2><div class="text-body-secondary small">Drafts and quote history for this customer.</div></div>
    <a class="btn btn-primary btn-sm" asp-controller="Quotes" asp-action="Create" asp-route-customerId="@Model.Customer.Id">Create quote</a>
</div>
@if (Model.Quotes.Count == 0)
{
    <div class="empty-state"><h3 class="h5">No quotes yet</h3><p class="text-body-secondary mb-3">Create the first draft quote for this customer.</p><a class="btn btn-primary" asp-controller="Quotes" asp-action="Create" asp-route-customerId="@Model.Customer.Id">Create quote</a></div>
}
else
{
    <div class="list-group shadow-sm mb-4">
    @foreach (var quote in Model.Quotes)
    {
        <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center gap-3" asp-controller="Quotes" asp-action="Details" asp-route-customerId="@Model.Customer.Id" asp-route-quoteId="@quote.Id">
            <span><strong class="d-block">@quote.Number</strong><span class="text-body-secondary small">@quote.CreatedAtUtc.ToString("yyyy-MM-dd") · @quote.Status</span></span>
            <strong>@quote.Total.ToString("0.00")</strong>
        </a>
    }
    </div>
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mt-5 mb-3">
    <div><h2 class="h4 mb-1">Invoices <span class="badge text-bg-secondary">@Model.Invoices.Count</span></h2><div class="text-body-secondary small">Draft invoices and billing history for this customer.</div></div>
    <a class="btn btn-primary btn-sm" asp-controller="Invoices" asp-action="Create" asp-route-customerId="@Model.Customer.Id">Create invoice</a>
</div>
@if (Model.Invoices.Count == 0)
{
    <div class="empty-state"><h3 class="h5">No invoices yet</h3><p class="text-body-secondary mb-3">Create the first draft invoice for this customer.</p><a class="btn btn-primary" asp-controller="Invoices" asp-action="Create" asp-route-customerId="@Model.Customer.Id">Create invoice</a></div>
}
else
{
    <div class="list-group shadow-sm mb-4">
    @foreach (var invoice in Model.Invoices)
    {
        <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center gap-3" asp-controller="Invoices" asp-action="Details" asp-route-customerId="@Model.Customer.Id" asp-route-invoiceId="@invoice.Id">
            <span><strong class="d-block">@invoice.Number</strong><span class="text-body-secondary small">@invoice.CreatedAtUtc.ToString("yyyy-MM-dd") · @invoice.Status</span></span>
            <strong>@invoice.Total.ToString("0.00")</strong>
        </a>
    }
    </div>
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mt-5 mb-3">
    <div>
        <h2 class="h4 mb-1">Documents <span class="badge text-bg-secondary">@Model.Documents.Count</span></h2>
        <div class="text-body-secondary small">Files stored for this customer.</div>
    </div>
    <form asp-action="UploadDocument" asp-route-id="@Model.Customer.Id" method="post" enctype="multipart/form-data" class="d-flex gap-2">
        <input class="form-control form-control-sm" type="file" name="file" required />
        <button class="btn btn-primary btn-sm text-nowrap" type="submit">Upload</button>
    </form>
</div>

@if (Model.Documents.Count == 0)
{
    <div class="empty-state">
        <h3 class="h5">No documents yet</h3>
        <p class="text-body-secondary mb-0">Upload the first file associated with this customer.</p>
    </div>
}
else
{
    <div class="list-group shadow-sm mb-4">
    @foreach (var document in Model.Documents)
    {
        <div class="list-group-item d-flex justify-content-between align-items-center gap-3">
            <span>
                <strong class="d-block">@document.FileName</strong>
                <span class="text-body-secondary small">@document.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC · @((document.Size / 1024d).ToString("0.#")) KB</span>
                @{
                    var activeShare = Model.DocumentShares.FirstOrDefault(share => share.DocumentId == document.Id);
                }
                @if (activeShare is not null)
                {
                    <span class="d-block small mt-1"><span class="badge text-bg-success">Shared</span> <span class="text-body-secondary">since @activeShare.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</span></span>
                }
                else
                {
                    <span class="d-block small mt-1"><span class="badge text-bg-secondary">Not shared</span></span>
                }
            </span>
            <span class="d-flex gap-2">
                @if (activeShare is null)
                {
                    <form asp-action="CreateDocumentShare" asp-route-customerId="@Model.Customer.Id" asp-route-documentId="@document.Id" method="post">
                        <button class="btn btn-sm btn-outline-primary" type="submit">Share</button>
                    </form>
                }
                else
                {
                    <button class="btn btn-sm btn-outline-warning"
                            type="button"
                            data-bs-toggle="modal"
                            data-bs-target="#revokeShareModal"
                            data-document-id="@document.Id"
                            data-share-id="@activeShare.Id"
                            data-document-name="@document.FileName">Revoke share</button>
                }
                <a class="btn btn-sm btn-outline-secondary"
                   asp-action="DownloadDocument"
                   asp-route-customerId="@Model.Customer.Id"
                   asp-route-documentId="@document.Id">Download</a>
                <button class="btn btn-sm btn-outline-danger"
                        type="button"
                        data-bs-toggle="modal"
                        data-bs-target="#deleteDocumentModal"
                        data-document-id="@document.Id"
                        data-document-name="@document.FileName">Delete</button>
            </span>
        </div>
    }
    </div>
}

@if (TempData["DocumentShareUrl"] is string documentShareUrl)
{
    <div class="alert alert-success d-flex flex-column flex-md-row align-items-md-center gap-2 mb-4" role="alert">
        <div class="flex-grow-1">
            <strong>Share link created.</strong>
            <div class="small text-break" id="documentShareUrl">@documentShareUrl</div>
        </div>
        <button class="btn btn-sm btn-success text-nowrap" type="button" id="copyDocumentShareUrl">Copy link</button>
    </div>
}

<div class="modal fade" id="revokeShareModal" tabindex="-1" aria-labelledby="revokeShareModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="revokeShareForm" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="revokeShareModalLabel">Revoke public link</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-2">Revoke the public link for <strong id="revokeShareDocumentName"></strong>?</p>
                    <p class="text-body-secondary small mb-0">Anyone using the current link will immediately receive a 404. You can create a new link afterwards.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning">Revoke link</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteDocumentModal" tabindex="-1" aria-labelledby="deleteDocumentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="deleteDocumentForm" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="deleteDocumentModalLabel">Delete document</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-2">Are you sure you want to delete <strong id="deleteDocumentName"></strong>?</p>
                    <p class="text-danger small mb-0">The stored file will also be permanently deleted.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Delete document</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="editContactModal" tabindex="-1" aria-labelledby="editContactModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="editContactForm" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="editContactModalLabel">Edit contact</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3"><label class="form-label" for="modalContactName">Name</label><input class="form-control" id="modalContactName" name="Name" required maxlength="200" /></div>
                    <div class="mb-3"><label class="form-label" for="modalContactRole">Role</label><input class="form-control" id="modalContactRole" name="Role" maxlength="100" /></div>
                    <div class="mb-3"><label class="form-label" for="modalContactEmail">Email</label><input class="form-control" id="modalContactEmail" name="Email" type="email" maxlength="320" /></div>
                    <div><label class="form-label" for="modalContactPhone">Phone</label><input class="form-control" id="modalContactPhone" name="Phone" maxlength="50" /></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save contact</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteContactModal" tabindex="-1" aria-labelledby="deleteContactModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="deleteContactForm" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="deleteContactModalLabel">Delete contact</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-2">Are you sure you want to delete <strong id="deleteContactName"></strong>?</p>
                    <p class="text-danger small mb-0">This action cannot be undone.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Delete contact</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    (() => {
        const customerId = "@Model.Customer.Id";
        const copyShareButton = document.getElementById("copyDocumentShareUrl");
        copyShareButton?.addEventListener("click", async () => {
            const shareUrl = document.getElementById("documentShareUrl")?.textContent?.trim();
            if (!shareUrl) return;
            await navigator.clipboard.writeText(shareUrl);
            copyShareButton.textContent = "Copied";
        });

        document.getElementById("revokeShareModal").addEventListener("show.bs.modal", event => {
            const button = event.relatedTarget;
            const documentId = button.dataset.documentId;
            const shareId = button.dataset.shareId;
            document.getElementById("revokeShareForm").action = `/Customers/${customerId}/Documents/${documentId}/Shares/${shareId}/Revoke`;
            document.getElementById("revokeShareDocumentName").textContent = button.dataset.documentName ?? "this document";
        });

        document.getElementById("deleteDocumentModal").addEventListener("show.bs.modal", event => {
            const button = event.relatedTarget;
            const documentId = button.dataset.documentId;
            document.getElementById("deleteDocumentForm").action = `/Customers/${customerId}/Documents/${documentId}/Delete`;
            document.getElementById("deleteDocumentName").textContent = button.dataset.documentName ?? "this document";
        });

        document.getElementById("editContactModal").addEventListener("show.bs.modal", event => {
            const button = event.relatedTarget;
            const contactId = button.dataset.contactId;
            document.getElementById("editContactForm").action = `/Customers/${customerId}/Contacts/${contactId}/Edit`;
            document.getElementById("modalContactName").value = button.dataset.contactName ?? "";
            document.getElementById("modalContactRole").value = button.dataset.contactRole ?? "";
            document.getElementById("modalContactEmail").value = button.dataset.contactEmail ?? "";
            document.getElementById("modalContactPhone").value = button.dataset.contactPhone ?? "";
        });

        document.getElementById("deleteContactModal").addEventListener("show.bs.modal", event => {
            const button = event.relatedTarget;
            const contactId = button.dataset.contactId;
            document.getElementById("deleteContactForm").action = `/Customers/${customerId}/Contacts/${contactId}/Delete`;
            document.getElementById("deleteContactName").textContent = button.dataset.contactName ?? "this contact";
        });
    })();
</script>
}
