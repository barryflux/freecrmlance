@model Freecrmlance.Web.Models.Customers.CustomerDetailsViewModel
@{ ViewData["Title"] = Model.Customer.Name; }

<div class="page-header d-flex flex-column flex-sm-row justify-content-between align-items-sm-start gap-3">
    <div><a class="text-decoration-none small" asp-action="Index">← Clients</a><h1 class="h2 mt-2 mb-0">@Model.Customer.Name</h1></div>
    <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.Customer.Id">Modifier le client</a>
</div>

<nav class="customer-tabs" aria-label="Rubriques du client">
    <a class="customer-tab active" href="#fiche" data-customer-tab="fiche">Fiche</a>
    <a class="customer-tab" href="#contacts" data-customer-tab="contacts">Contacts <span>@Model.Contacts.Count</span></a>
    <a class="customer-tab" href="#documents" data-customer-tab="documents">Documents <span>@Model.Documents.Count</span></a>
    <a class="customer-tab" href="#quotes" data-customer-tab="quotes">Devis <span>@Model.Quotes.Count</span></a>
    <a class="customer-tab" href="#invoices" data-customer-tab="invoices">Factures <span>@Model.Invoices.Count</span></a>
</nav>

<section class="customer-tab-panel" data-customer-panel="fiche">
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-4">
        <h2 class="h5 mb-3">Informations client</h2>
        <div class="row g-3">
            <div class="col-md-6"><div class="text-body-secondary small">Email</div><div>@(Model.Customer.Email ?? "—")</div></div>
            <div class="col-md-6"><div class="text-body-secondary small">Téléphone</div><div>@(Model.Customer.Phone ?? "—")</div></div>
        </div>
    </div>
    @if (Model.Customer.Type is not null)
    {
        <hr />
        <h2 class="h5 mb-3">Identité de facturation</h2>
        <div class="row g-3">
            <div class="col-md-4"><div class="text-body-secondary small">Type</div><div>@Model.Customer.Type</div></div>
            @if (Model.Customer.Type == Freecrmlance.Domain.Crm.CustomerType.Business)
            {
                <div class="col-md-4"><div class="text-body-secondary small">SIREN</div><div>@Model.Customer.Siren</div></div>
                <div class="col-md-4"><div class="text-body-secondary small">SIRET</div><div>@(Model.Customer.Siret ?? "—")</div></div>
                <div class="col-md-4"><div class="text-body-secondary small">N° TVA intracommunautaire</div><div>@(Model.Customer.VatNumber ?? "—")</div></div>
            }
            <div class="col-md-8"><div class="text-body-secondary small">Adresse</div><div>@Model.Customer.AddressLine1@if (!string.IsNullOrWhiteSpace(Model.Customer.AddressLine2)) { <text>, @Model.Customer.AddressLine2</text> }<br />@Model.Customer.PostalCode @Model.Customer.City · @Model.Customer.CountryCode</div></div>
            @if (!string.IsNullOrWhiteSpace(Model.Customer.BillingAddressLine1))
            {
                <div class="col-md-8"><div class="text-body-secondary small">Adresse de facturation</div><div>@Model.Customer.BillingAddressLine1@if (!string.IsNullOrWhiteSpace(Model.Customer.BillingAddressLine2)) { <text>, @Model.Customer.BillingAddressLine2</text> }<br />@Model.Customer.BillingPostalCode @Model.Customer.BillingCity · @Model.Customer.BillingCountryCode</div></div>
            }
        </div>
    }
</div>

</section>

<section class="customer-tab-panel d-none" data-customer-panel="contacts">
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 mb-0">Contacts <span class="badge text-bg-secondary">@Model.Contacts.Count</span></h2>
    <a class="btn btn-primary btn-sm" asp-action="CreateContact" asp-route-id="@Model.Customer.Id">Ajouter un contact</a>
</div>

@if (Model.Contacts.Count == 0)
{
    <div class="empty-state"><h3 class="h5">Aucun contact</h3><p class="text-body-secondary mb-3">Ajoutez la première personne associée à ce client.</p><a class="btn btn-primary" asp-action="CreateContact" asp-route-id="@Model.Customer.Id">Ajouter un contact</a></div>
}
else
{
    <div class="row g-3">
    @foreach (var contact in Model.Contacts)
    {
        <div class="col-md-6 col-xl-4">
            <article class="card contact-card shadow-sm border-0">
                <div class="card-body">
                    <div class="d-flex justify-content-between gap-2 mb-3"><div><h3 class="h5 mb-1">@contact.Name</h3><span class="text-body-secondary small">@(contact.Role ?? "Fonction non renseignée")</span></div></div>
                    <div class="small mb-1"><span class="text-body-secondary">Email:</span> @if (contact.Email is not null) { <a href="mailto:@contact.Email">@contact.Email</a> } else { <span>—</span> }</div>
                    <div class="small"><span class="text-body-secondary">Téléphone:</span> @if (contact.Phone is not null) { <a href="tel:@contact.Phone">@contact.Phone</a> } else { <span>—</span> }</div>
                </div>
                <div class="card-footer bg-transparent d-flex gap-2">
                    <button class="btn btn-sm btn-outline-secondary"
                            type="button"
                            data-bs-toggle="modal"
                            data-bs-target="#editContactModal"
                            data-contact-id="@contact.Id"
                            data-contact-name="@contact.Name"
                            data-contact-role="@contact.Role"
                            data-contact-email="@contact.Email"
                            data-contact-phone="@contact.Phone">Modifier</button>
                    <button class="btn btn-sm btn-outline-danger"
                            type="button"
                            data-bs-toggle="modal"
                            data-bs-target="#deleteContactModal"
                            data-contact-id="@contact.Id"
                            data-contact-name="@contact.Name">Supprimer</button>
                </div>
            </article>
        </div>
    }
    </div>
}




</section>

<section class="customer-tab-panel d-none" data-customer-panel="quotes">
<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-3">
    <div><h2 class="h4 mb-1">Devis <span class="badge text-bg-secondary">@Model.Quotes.Count</span></h2><div class="text-body-secondary small">Brouillons et historique des devis de ce client.</div></div>
    <a class="btn btn-primary btn-sm" asp-controller="Quotes" asp-action="Create" asp-route-customerId="@Model.Customer.Id">Créer un devis</a>
</div>
@if (Model.Quotes.Count == 0)
{
    <div class="empty-state"><h3 class="h5">Aucun devis</h3><p class="text-body-secondary mb-3">Créez le premier brouillon de devis pour ce client.</p><a class="btn btn-primary" asp-controller="Quotes" asp-action="Create" asp-route-customerId="@Model.Customer.Id">Créer un devis</a></div>
}
else
{
    <div class="list-group shadow-sm mb-4">
    @foreach (var quote in Model.Quotes)
    {
        <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center gap-3" asp-controller="Quotes" asp-action="Details" asp-route-customerId="@Model.Customer.Id" asp-route-quoteId="@quote.Id">
            <span><strong class="d-block">@quote.Number</strong><span class="text-body-secondary small">@quote.CreatedAtUtc.ToString("dd/MM/yyyy") · @(quote.Status switch { Freecrmlance.Domain.Crm.QuoteStatus.Draft => "Brouillon", Freecrmlance.Domain.Crm.QuoteStatus.Sent => "Envoyé", Freecrmlance.Domain.Crm.QuoteStatus.Accepted => "Accepté", Freecrmlance.Domain.Crm.QuoteStatus.Rejected => "Refusé", _ => quote.Status.ToString() })</span></span>
            <strong>@quote.Total.ToString("C")</strong>
        </a>
    }
    </div>
}

</section>

<section class="customer-tab-panel d-none" data-customer-panel="invoices">
<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-3">
    <div><h2 class="h4 mb-1">Factures <span class="badge text-bg-secondary">@Model.Invoices.Count</span></h2><div class="text-body-secondary small">Brouillons et historique de facturation de ce client.</div></div>
    <a class="btn btn-primary btn-sm" asp-controller="Invoices" asp-action="Create" asp-route-customerId="@Model.Customer.Id">Créer une facture</a>
</div>
@if (Model.Invoices.Count == 0)
{
    <div class="empty-state"><h3 class="h5">Aucune facture</h3><p class="text-body-secondary mb-3">Créez la première facture brouillon pour ce client.</p><a class="btn btn-primary" asp-controller="Invoices" asp-action="Create" asp-route-customerId="@Model.Customer.Id">Créer une facture</a></div>
}
else
{
    <div class="list-group shadow-sm mb-4">
    @foreach (var invoice in Model.Invoices)
    {
        <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center gap-3" asp-controller="Invoices" asp-action="Details" asp-route-customerId="@Model.Customer.Id" asp-route-invoiceId="@invoice.Id">
            <span><strong class="d-block">@invoice.Number</strong><span class="text-body-secondary small">@invoice.CreatedAtUtc.ToString("dd/MM/yyyy") · @(invoice.Status == Freecrmlance.Domain.Billing.InvoiceStatus.Draft ? "Brouillon" : "Émise")</span></span>
            <strong>@invoice.Total.ToString("C")</strong>
        </a>
    }
    </div>
}

</section>

<section class="customer-tab-panel d-none" data-customer-panel="documents">
<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-3">
    <div>
        <h2 class="h4 mb-1">Documents <span class="badge text-bg-secondary">@Model.Documents.Count</span></h2>
        <div class="text-body-secondary small">Fichiers associés à ce client.</div>
    </div>
    <form asp-action="UploadDocument" asp-route-id="@Model.Customer.Id" method="post" enctype="multipart/form-data" class="d-flex gap-2">
        <input class="form-control form-control-sm" type="file" name="file" required />
        <button class="btn btn-primary btn-sm text-nowrap" type="submit">Importer</button>
    </form>
</div>

@if (Model.Documents.Count == 0)
{
    <div class="empty-state">
        <h3 class="h5">Aucun document</h3>
        <p class="text-body-secondary mb-0">Importez le premier fichier associé à ce client.</p>
    </div>
}
else
{
    <div class="list-group shadow-sm mb-4">
    @foreach (var document in Model.Documents)
    {
        <div class="list-group-item d-flex justify-content-between align-items-center gap-3">
            <span>
                <strong class="d-block">@document.FileName</strong>
                <span class="text-body-secondary small">@document.CreatedAtUtc.ToString("dd/MM/yyyy HH:mm") · @((document.Size / 1024d).ToString("0.#")) Ko</span>
                @{
                    var activeShare = Model.DocumentShares.FirstOrDefault(share => share.DocumentId == document.Id);
                }
                @if (activeShare is not null)
                {
                    <span class="d-block small mt-1"><span class="badge text-bg-success">Partagé</span> <span class="text-body-secondary">depuis le @activeShare.CreatedAtUtc.ToString("dd/MM/yyyy à HH:mm")</span></span>
                }
                else
                {
                    <span class="d-block small mt-1"><span class="badge text-bg-secondary">Non partagé</span></span>
                }
            </span>
            <span class="d-flex gap-2">
                @if (activeShare is null)
                {
                    <form asp-action="CreateDocumentShare" asp-route-customerId="@Model.Customer.Id" asp-route-documentId="@document.Id" method="post">
                        <button class="btn btn-sm btn-outline-primary" type="submit">Partager</button>
                    </form>
                }
                else
                {
                    <button class="btn btn-sm btn-outline-warning"
                            type="button"
                            data-bs-toggle="modal"
                            data-bs-target="#revokeShareModal"
                            data-document-id="@document.Id"
                            data-share-id="@activeShare.Id"
                            data-document-name="@document.FileName">Révoquer le partage</button>
                }
                <a class="btn btn-sm btn-outline-secondary"
                   asp-action="DownloadDocument"
                   asp-route-customerId="@Model.Customer.Id"
                   asp-route-documentId="@document.Id">Télécharger</a>
                <button class="btn btn-sm btn-outline-danger"
                        type="button"
                        data-bs-toggle="modal"
                        data-bs-target="#deleteDocumentModal"
                        data-document-id="@document.Id"
                        data-document-name="@document.FileName">Supprimer</button>
            </span>
        </div>
    }
    </div>
}

</section>

@if (TempData["DocumentShareUrl"] is string documentShareUrl)
{
    <div class="alert alert-success d-flex flex-column flex-md-row align-items-md-center gap-2 mb-4" role="alert">
        <div class="flex-grow-1">
            <strong>Lien de partage créé.</strong>
            <div class="small text-break" id="documentShareUrl">@documentShareUrl</div>
        </div>
        <button class="btn btn-sm btn-success text-nowrap" type="button" id="copyDocumentShareUrl">Copier le lien</button>
    </div>
}

<div class="modal fade" id="revokeShareModal" tabindex="-1" aria-labelledby="revokeShareModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="revokeShareForm" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="revokeShareModalLabel">Révoquer le lien public</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-2">Révoquer le lien public de <strong id="revokeShareDocumentName"></strong>?</p>
                    <p class="text-body-secondary small mb-0">Le lien actuel cessera immédiatement de fonctionner. Vous pourrez ensuite créer un nouveau lien.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-warning">Révoquer le lien</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteDocumentModal" tabindex="-1" aria-labelledby="deleteDocumentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="deleteDocumentForm" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="deleteDocumentModalLabel">Supprimer document</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-2">Voulez-vous vraiment supprimer <strong id="deleteDocumentName"></strong>?</p>
                    <p class="text-danger small mb-0">Le fichier stocké sera également supprimé définitivement.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-danger">Supprimer document</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="editContactModal" tabindex="-1" aria-labelledby="editContactModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="editContactForm" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="editContactModalLabel">Modifier le contact</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3"><label class="form-label" for="modalContactName">Nom</label><input class="form-control" id="modalContactName" name="Name" required maxlength="200" /></div>
                    <div class="mb-3"><label class="form-label" for="modalContactRole">Fonction</label><input class="form-control" id="modalContactRole" name="Role" maxlength="100" /></div>
                    <div class="mb-3"><label class="form-label" for="modalContactEmail">Email</label><input class="form-control" id="modalContactEmail" name="Email" type="email" maxlength="320" /></div>
                    <div><label class="form-label" for="modalContactPhone">Téléphone</label><input class="form-control" id="modalContactPhone" name="Phone" maxlength="50" /></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-primary">Enregistrer</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteContactModal" tabindex="-1" aria-labelledby="deleteContactModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="deleteContactForm" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="deleteContactModalLabel">Supprimer contact</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-2">Voulez-vous vraiment supprimer <strong id="deleteContactName"></strong>?</p>
                    <p class="text-danger small mb-0">Cette action est irréversible.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-danger">Supprimer contact</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    (() => {
        const customerId = "@Model.Customer.Id";
        const tabs = [...document.querySelectorAll("[data-customer-tab]")];
        const panels = [...document.querySelectorAll("[data-customer-panel]")];
        const knownTabs = new Set(tabs.map(tab => tab.dataset.customerTab));

        const showTab = name => {
            const selected = knownTabs.has(name) ? name : "fiche";
            tabs.forEach(tab => {
                const active = tab.dataset.customerTab === selected;
                tab.classList.toggle("active", active);
                if (active) tab.setAttribute("aria-current", "page");
                else tab.removeAttribute("aria-current");
            });
            panels.forEach(panel => panel.classList.toggle("d-none", panel.dataset.customerPanel !== selected));
        };

        const showHashTab = () => showTab(window.location.hash.replace("#", ""));
        tabs.forEach(tab => tab.addEventListener("click", () => showTab(tab.dataset.customerTab)));
        window.addEventListener("hashchange", showHashTab);
        showHashTab();
        const copyPartagerButton = document.getElementById("copyDocumentShareUrl");
        copyPartagerButton?.addEventListener("click", async () => {
            const shareUrl = document.getElementById("documentShareUrl")?.textContent?.trim();
            if (!shareUrl) return;
            await navigator.clipboard.writeText(shareUrl);
            copyPartagerButton.textContent = "Copié";
        });

        document.getElementById("revokeShareModal").addEventListener("show.bs.modal", event => {
            const button = event.relatedTarget;
            const documentId = button.dataset.documentId;
            const shareId = button.dataset.shareId;
            document.getElementById("revokeShareForm").action = `/Customers/${customerId}/Documents/${documentId}/Shares/${shareId}/Revoke`;
            document.getElementById("revokeShareDocumentName").textContent = button.dataset.documentName ?? "ce document";
        });

        document.getElementById("deleteDocumentModal").addEventListener("show.bs.modal", event => {
            const button = event.relatedTarget;
            const documentId = button.dataset.documentId;
            document.getElementById("deleteDocumentForm").action = `/Customers/${customerId}/Documents/${documentId}/Delete`;
            document.getElementById("deleteDocumentName").textContent = button.dataset.documentName ?? "ce document";
        });

        document.getElementById("editContactModal").addEventListener("show.bs.modal", event => {
            const button = event.relatedTarget;
            const contactId = button.dataset.contactId;
            document.getElementById("editContactForm").action = `/Customers/${customerId}/Contacts/${contactId}/Edit`;
            document.getElementById("modalContactName").value = button.dataset.contactName ?? "";
            document.getElementById("modalContactRole").value = button.dataset.contactRole ?? "";
            document.getElementById("modalContactEmail").value = button.dataset.contactEmail ?? "";
            document.getElementById("modalContactPhone").value = button.dataset.contactPhone ?? "";
        });

        document.getElementById("deleteContactModal").addEventListener("show.bs.modal", event => {
            const button = event.relatedTarget;
            const contactId = button.dataset.contactId;
            document.getElementById("deleteContactForm").action = `/Customers/${customerId}/Contacts/${contactId}/Delete`;
            document.getElementById("deleteContactName").textContent = button.dataset.contactName ?? "ce contact";
        });
    })();
</script>
}
