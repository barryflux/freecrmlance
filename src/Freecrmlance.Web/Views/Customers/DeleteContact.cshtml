@model Freecrmlance.Application.Crm.ContactDto
@{
    ViewData["Title"] = "Delete contact";
}

<h1>Delete contact</h1>

<p>Are you sure you want to delete this contact?</p>

<dl>
    <dt>Name</dt>
    <dd>@Model.Name</dd>
    <dt>Role</dt>
    <dd>@(Model.Role ?? "—")</dd>
    <dt>Email</dt>
    <dd>@(Model.Email ?? "—")</dd>
    <dt>Phone</dt>
    <dd>@(Model.Phone ?? "—")</dd>
</dl>

<form asp-action="DeleteContactConfirmed"
      asp-route-customerId="@Model.CustomerId"
      asp-route-contactId="@Model.Id"
      method="post">
    <button type="submit">Delete contact</button>
    <a asp-action="Details" asp-route-id="@Model.CustomerId">Cancel</a>
</form>
