@model Freecrmlance.Application.Crm.ContactDto
@{ ViewData["Title"] = "Delete contact"; }
<div class="form-card">
    <div class="page-header"><h1 class="h2">Delete contact</h1></div>
    <div class="alert alert-danger"><strong>This action cannot be undone.</strong> Confirm that you want to delete this contact.</div>
    <div class="card shadow-sm border-0"><div class="card-body p-4">
        <h2 class="h5">@Model.Name</h2>
        <dl class="row mb-4">
            <dt class="col-sm-3">Role</dt><dd class="col-sm-9">@(Model.Role ?? "—")</dd>
            <dt class="col-sm-3">Email</dt><dd class="col-sm-9">@(Model.Email ?? "—")</dd>
            <dt class="col-sm-3">Phone</dt><dd class="col-sm-9">@(Model.Phone ?? "—")</dd>
        </dl>
        <form asp-action="DeleteContactConfirmed" asp-route-customerId="@Model.CustomerId" asp-route-contactId="@Model.Id" method="post" class="d-flex gap-2">
            <button class="btn btn-danger" type="submit">Delete contact</button>
            <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.CustomerId">Cancel</a>
        </form>
    </div></div>
</div>
