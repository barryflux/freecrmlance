@model IReadOnlyList<Freecrmlance.Application.Crm.CustomerDto>
@{ ViewData["Title"] = "Clients"; }

<div class="page-header d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3">
    <div>
        <h1 class="h2 mb-1">Clients</h1>
        <p class="text-body-secondary mb-0"><span id="customerCount">@Model.Count</span> client@(Model.Count > 1 ? "s" : "")</p>
    </div>
    <div class="d-flex gap-2"><a class="btn btn-outline-secondary" asp-controller="CustomerImports" asp-action="Index">Importer des clients</a><a class="btn btn-primary" asp-action="Create">Ajouter un client</a></div>
</div>

@if (Model.Count == 0)
{
    <div class="empty-state">
        <h2 class="h5">Aucun client</h2>
        <p class="text-body-secondary">Ajoutez votre premier client pour centraliser ses contacts, documents, devis et factures.</p>
        <a class="btn btn-primary" asp-action="Create">Ajouter un client</a>
    </div>
}
else
{
    <div class="customer-list-toolbar">
        <label class="visually-hidden" for="customerSearch">Rechercher un client</label>
        <div class="input-group">
            <span class="input-group-text" aria-hidden="true">⌕</span>
            <input id="customerSearch" class="form-control" type="search" placeholder="Nom, email ou téléphone…" autocomplete="off" />
        </div>
    </div>

    <div class="customer-mobile-list d-md-none" id="customerMobileList">
        @foreach (var customer in Model)
        {
            <article class="customer-mobile-item" data-customer-item>
                <a class="customer-mobile-main" asp-action="Details" asp-route-id="@customer.Id">
                    <strong>@customer.Name</strong>
                    <span>@(customer.Email ?? customer.Phone ?? "Coordonnées non renseignées")</span>
                </a>
                <div class="customer-mobile-actions">
                    <a asp-action="Details" asp-route-id="@customer.Id">Ouvrir</a>
                    <a asp-action="Edit" asp-route-id="@customer.Id">Modifier</a>
                </div>
            </article>
        }
    </div>

    <div class="customer-table-wrap d-none d-md-block">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="customersTable">
                <thead>
                    <tr>
                        <th scope="col"><button class="btn btn-sm p-0 fw-semibold sort-button" type="button" data-sort="name">Nom ↕</button></th>
                        <th scope="col"><button class="btn btn-sm p-0 fw-semibold sort-button" type="button" data-sort="email">Email ↕</button></th>
                        <th scope="col"><button class="btn btn-sm p-0 fw-semibold sort-button" type="button" data-sort="phone">Téléphone ↕</button></th>
                        <th scope="col" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var customer in Model)
                {
                    <tr data-customer-item>
                        <td data-value="name"><a class="fw-semibold text-decoration-none" asp-action="Details" asp-route-id="@customer.Id">@customer.Name</a></td>
                        <td data-value="email">@(customer.Email ?? "—")</td>
                        <td data-value="phone">@(customer.Phone ?? "—")</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@customer.Id">Modifier</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    <div id="noCustomerResults" class="empty-state mt-3 d-none">
        <h2 class="h5">Aucun client correspondant</h2>
        <p class="text-body-secondary mb-0">Modifiez votre recherche.</p>
    </div>
}

@section Scripts {
<script>
(() => {
    const search = document.getElementById("customerSearch");
    if (!search) return;

    const count = document.getElementById("customerCount");
    const empty = document.getElementById("noCustomerResults");
    const mobileItems = [...document.querySelectorAll("#customerMobileList [data-customer-item]")];
    const desktopRows = [...document.querySelectorAll("#customersTable [data-customer-item]")];
    let sortDirection = 1;
    let lastSort = "";

    const filter = () => {
        const query = search.value.trim().toLocaleLowerCase();
        let visible = 0;

        desktopRows.forEach(row => {
            const matches = row.textContent.toLocaleLowerCase().includes(query);
            row.classList.toggle("d-none", !matches);
            if (matches) visible++;
        });

        mobileItems.forEach(item => {
            const matches = item.textContent.toLocaleLowerCase().includes(query);
            item.classList.toggle("d-none", !matches);
        });

        count.textContent = visible;
        empty.classList.toggle("d-none", visible !== 0);
    };

    search.addEventListener("input", filter);

    document.querySelectorAll(".sort-button").forEach(button => {
        button.addEventListener("click", () => {
            const key = button.dataset.sort;
            sortDirection = lastSort === key ? sortDirection * -1 : 1;
            lastSort = key;

            const tbody = document.querySelector("#customersTable tbody");
            [...desktopRows]
                .sort((a, b) => {
                    const left = a.querySelector(`[data-value="${key}"]`).textContent.trim();
                    const right = b.querySelector(`[data-value="${key}"]`).textContent.trim();
                    return left.localeCompare(right, "fr", { sensitivity: "base" }) * sortDirection;
                })
                .forEach(row => tbody.appendChild(row));
        });
    });
})();
</script>
}
