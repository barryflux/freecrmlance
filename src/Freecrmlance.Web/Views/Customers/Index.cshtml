@model IReadOnlyList<Freecrmlance.Application.Crm.CustomerDto>
@{ ViewData["Title"] = "Customers"; }

<div class="page-header d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3">
    <div>
        <h1 class="h2 mb-1">Customers</h1>
        <p class="text-body-secondary mb-0">Manage your customers and their contacts.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">Add customer</a>
</div>

@if (Model.Count == 0)
{
    <div class="empty-state">
        <h2 class="h5">No customers yet</h2>
        <p class="text-body-secondary">Create your first customer to start centralizing the relationship.</p>
        <a class="btn btn-primary" asp-action="Create">Add customer</a>
    </div>
}
else
{
    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light"><tr><th>Name</th><th>Email</th><th>Phone</th></tr></thead>
                <tbody>
                @foreach (var customer in Model)
                {
                    <tr>
                        <td><a class="fw-semibold text-decoration-none" asp-action="Details" asp-route-id="@customer.Id">@customer.Name</a></td>
                        <td>@(customer.Email ?? "—")</td>
                        <td>@(customer.Phone ?? "—")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
