@model IReadOnlyList<Freecrmlance.Application.Crm.CustomerDto>
@{ ViewData["Title"] = "Clients"; }

<section class="hero-panel mb-4">
    <div>
        <span class="eyebrow">Votre activité</span>
        <h1>Bonjour 👋</h1>
        <p>Retrouvez vos clients et accédez à toute leur relation commerciale depuis un seul endroit.</p>
    </div>
    <a class="btn btn-primary btn-lg" asp-action="Create">+ Nouveau client</a>
</section>

<div class="metric-grid mb-4">
    <div class="metric-card">
        <span class="metric-icon">CL</span>
        <div><strong>@Model.Count</strong><span>Clients</span></div>
    </div>
    <div class="metric-card metric-card-muted">
        <span class="metric-icon">→</span>
        <div><strong>Centralisé</strong><span>Contacts, devis, factures et documents</span></div>
    </div>
</div>

<section class="content-section">
    <div class="section-heading">
        <div>
            <span class="eyebrow">CRM</span>
            <h2>Vos clients</h2>
            <p>Un client, un espace, toute la relation.</p>
        </div>
        @if (Model.Count > 0)
        {
            <div class="search-field">
                <span aria-hidden="true">⌕</span>
                <input id="customerSearch" type="search" placeholder="Rechercher…" aria-label="Rechercher un client" />
            </div>
        }
    </div>

    @if (Model.Count == 0)
    {
        <div class="empty-state empty-state-product">
            <div class="empty-state-icon" aria-hidden="true">+</div>
            <h3>Créez votre premier client</h3>
            <p>Sa fiche regroupera ses contacts, documents, devis et factures.</p>
            <a class="btn btn-primary" asp-action="Create">Ajouter un client</a>
        </div>
    }
    else
    {
        <div class="customer-grid" id="customersGrid">
        @foreach (var customer in Model)
        {
            <article class="customer-card" data-customer-card>
                <a class="customer-card-main" asp-action="Details" asp-route-id="@customer.Id">
                    <span class="customer-avatar">@customer.Name.Substring(0, 1).ToUpperInvariant()</span>
                    <span class="customer-copy">
                        <strong>@customer.Name</strong>
                        <small>@(customer.Email ?? "Aucun email renseigné")</small>
                    </span>
                    <span class="customer-arrow" aria-hidden="true">→</span>
                </a>
                <div class="customer-card-meta">
                    <span>@(customer.Phone ?? "Téléphone non renseigné")</span>
                    <a asp-action="Edit" asp-route-id="@customer.Id">Modifier</a>
                </div>
            </article>
        }
        </div>
        <div id="noCustomerResults" class="empty-state d-none mt-3">
            <h3 class="h5">Aucun résultat</h3>
            <p class="mb-0">Essayez une autre recherche.</p>
        </div>
    }
</section>

@section Scripts {
<script>
(() => {
    const search = document.getElementById("customerSearch");
    if (!search) return;
    const cards = [...document.querySelectorAll("[data-customer-card]")];
    const empty = document.getElementById("noCustomerResults");
    search.addEventListener("input", () => {
        const query = search.value.trim().toLocaleLowerCase();
        let visible = 0;
        cards.forEach(card => {
            const matches = card.textContent.toLocaleLowerCase().includes(query);
            card.classList.toggle("d-none", !matches);
            if (matches) visible++;
        });
        empty.classList.toggle("d-none", visible !== 0);
    });
})();
</script>
}
