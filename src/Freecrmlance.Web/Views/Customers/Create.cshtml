@model Freecrmlance.Web.Models.Customers.CreateCustomerViewModel
@{
    ViewData["Title"] = "Ajouter un client";
}

<div class="page-header">
    <h1 class="h2 mb-1">Ajouter un client</h1>
    <p class="text-body-secondary mb-0">Créez la fiche client. Vous pourrez ensuite ajouter ses interlocuteurs depuis l’onglet Contacts.</p>
</div>
<div class="card shadow-sm border-0"><div class="card-body p-4">
<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <fieldset class="mb-4">
        <legend class="h5 mb-3">Informations générales</legend>
        <div class="mb-3">
            <label class="form-label" asp-for="Name">Nom</label>
            <input class="form-control" asp-for="Name" />
            <span asp-validation-for="Name"></span>
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="Email">E-mail</label>
            <input class="form-control" asp-for="Email" />
            <span asp-validation-for="Email"></span>
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="Phone">Téléphone</label>
            <input class="form-control" asp-for="Phone" />
            <span asp-validation-for="Phone"></span>
        </div>
    </fieldset>

    <partial name="_BillingIdentity" model="Model" />

    <button type="submit" class="btn btn-primary">Créer le client</button>
    <a class="btn btn-link" asp-action="Index">Annuler</a>
</form>
</div></div>
