@model Freecrmlance.Web.Models.Customers.CreateCustomerViewModel
@{
    ViewData["Title"] = "Add customer";
}

<div class="page-header">
    <h1 class="h2 mb-1">Add customer</h1>
    <p class="text-body-secondary mb-0">Create the customer and add the people you work with.</p>
</div>
<div class="card shadow-sm border-0"><div class="card-body p-4">
<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <fieldset class="mb-4">
        <legend class="h5 mb-3">Customer information</legend>
        <div class="mb-3">
            <label class="form-label" asp-for="Name"></label>
            <input class="form-control" asp-for="Name" />
            <span asp-validation-for="Name"></span>
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="Email"></label>
            <input class="form-control" asp-for="Email" />
            <span asp-validation-for="Email"></span>
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="Phone"></label>
            <input class="form-control" asp-for="Phone" />
            <span asp-validation-for="Phone"></span>
        </div>
    </fieldset>

    <fieldset>
        <legend class="h5 mb-3">Contacts</legend>
        <div id="contacts">
            @for (var i = 0; i < Model.Contacts.Count; i++)
            {
                <div class="contact-fields border rounded p-3 mb-3 bg-body-tertiary">
                    <h3>Contact @(i + 1)</h3>
                    @if (i > 0)
                    {
                        <button type="button" class="remove-contact btn btn-sm btn-outline-danger mb-3">Remove contact</button>
                    }
                    <div>
                        <label asp-for="Contacts[i].Name"></label>
                        <input class="form-control" asp-for="Contacts[i].Name" />
                        <span asp-validation-for="Contacts[i].Name"></span>
                    </div>
                    <div>
                        <label asp-for="Contacts[i].Email"></label>
                        <input class="form-control" asp-for="Contacts[i].Email" />
                        <span asp-validation-for="Contacts[i].Email"></span>
                    </div>
                    <div>
                        <label asp-for="Contacts[i].Phone"></label>
                        <input class="form-control" asp-for="Contacts[i].Phone" />
                        <span asp-validation-for="Contacts[i].Phone"></span>
                    </div>
                    <div>
                        <label asp-for="Contacts[i].Role"></label>
                        <input class="form-control" asp-for="Contacts[i].Role" />
                        <span asp-validation-for="Contacts[i].Role"></span>
                    </div>
                </div>
            }
        </div>
        <button type="button" id="add-contact" class="btn btn-outline-primary btn-sm">+ Add contact</button>
    </fieldset>

    <button type="submit" class="btn btn-primary">Create customer</button>
</form>
<a class="btn btn-link" asp-action="Index">Cancel</a>
</div></div>

<script>
    (() => {
        const contacts = document.getElementById("contacts");
        const addButton = document.getElementById("add-contact");

        const renumberContacts = () => {
            contacts.querySelectorAll(".contact-fields").forEach((contact, index) => {
                contact.querySelector("h3").textContent = `Contact ${index + 1}`;
                contact.querySelectorAll("input").forEach(input => {
                    const field = input.name.split(".").pop();
                    input.name = `Contacts[${index}].${field}`;
                    input.id = `Contacts_${index}__${field}`;
                    const label = contact.querySelector(`label[for$="__${field}"]`);
                    if (label) label.htmlFor = input.id;
                });
            });
        };

        contacts.addEventListener("click", event => {
            if (!event.target.classList.contains("remove-contact")) return;
            event.target.closest(".contact-fields").remove();
            renumberContacts();
        });

        addButton.addEventListener("click", () => {
            const index = contacts.querySelectorAll(".contact-fields").length;
            const wrapper = document.createElement("div");
            wrapper.className = "contact-fields border rounded p-3 mb-3 bg-body-tertiary";
            wrapper.innerHTML = `
                <h3>Contact ${index + 1}</h3>
                <button type="button" class="remove-contact btn btn-sm btn-outline-danger mb-3">Remove contact</button>
                <div class="mb-3"><label class="form-label" for="Contacts_${index}__Name">Name</label><input id="Contacts_${index}__Name" name="Contacts[${index}].Name" class="form-control" /></div>
                <div class="mb-3"><label class="form-label" for="Contacts_${index}__Email">Email</label><input id="Contacts_${index}__Email" name="Contacts[${index}].Email" type="email" class="form-control" /></div>
                <div class="mb-3"><label class="form-label" for="Contacts_${index}__Phone">Phone</label><input id="Contacts_${index}__Phone" name="Contacts[${index}].Phone" class="form-control" /></div>
                <div class="mb-3"><label class="form-label" for="Contacts_${index}__Role">Role</label><input id="Contacts_${index}__Role" name="Contacts[${index}].Role" class="form-control" /></div>
            `;
            contacts.appendChild(wrapper);
        });
    })();
</script>
