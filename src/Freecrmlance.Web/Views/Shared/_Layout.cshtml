@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var customersActive = currentController is "Customers" or "Contacts" or "Documents" or "Quotes" or "Invoices";
    var settingsActive = currentController == "WorkspaceSettings";
    var auditsActive = currentController == "AuditTemplates";
    var isLanding = currentController == "Home";
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Alouva</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@if (User.Identity?.IsAuthenticated == true)
{
    <div class="app-shell">
        <aside class="app-sidebar" aria-label="Navigation de l'application">
            <div class="app-sidebar-top">
                <a class="app-brand" asp-controller="Customers" asp-action="Index">Alouva</a>
                <nav class="app-nav" aria-label="Navigation principale">
                    <a class="app-nav-link @(customersActive ? "active" : null)"
                       aria-current="@(customersActive ? "page" : null)"
                       asp-controller="Customers" asp-action="Index">
                        Clients
                    </a>
                    <a class="app-nav-link @(auditsActive ? "active" : null)" aria-current="@(auditsActive ? "page" : null)" asp-controller="AuditTemplates" asp-action="Index">Audits</a>
                    <a class="app-nav-link @(settingsActive ? "active" : null)"
                       aria-current="@(settingsActive ? "page" : null)"
                       asp-controller="WorkspaceSettings" asp-action="LegalIdentity">
                        Paramètres
                    </a>
                </nav>
            </div>

            <div class="app-account">
                @if (!string.IsNullOrWhiteSpace(User.Identity?.Name))
                {
                    <div class="app-account-identity">
                        <span class="app-account-label">Connecté</span>
                        <span class="app-account-name" title="@User.Identity.Name">@User.Identity.Name</span>
                    </div>
                }
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button class="btn btn-outline-secondary w-100" type="submit">Se déconnecter</button>
                </form>
            </div>
        </aside>

        <div class="app-main">
            <header class="app-mobile-header">
                <a class="app-brand" asp-controller="Customers" asp-action="Index">Alouva</a>
                <button class="btn app-menu-button" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileNav"
                        aria-controls="mobileNav" aria-label="Ouvrir le menu">
                    <span aria-hidden="true">☰</span>
                    <span>Menu</span>
                </button>
            </header>
            <main class="app-content">@RenderBody()</main>
        </div>
    </div>

    <div class="offcanvas offcanvas-start app-mobile-nav" tabindex="-1" id="mobileNav" aria-labelledby="mobileNavLabel">
        <div class="offcanvas-header">
            <h2 class="offcanvas-title app-brand mb-0" id="mobileNavLabel">Alouva</h2>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Fermer le menu"></button>
        </div>
        <div class="offcanvas-body d-flex flex-column">
            <nav class="app-nav" aria-label="Navigation mobile">
                <a class="app-nav-link @(customersActive ? "active" : null)"
                   aria-current="@(customersActive ? "page" : null)"
                   asp-controller="Customers" asp-action="Index">
                    Clients
                </a>
                <a class="app-nav-link @(auditsActive ? "active" : null)" aria-current="@(auditsActive ? "page" : null)" asp-controller="AuditTemplates" asp-action="Index">Audits</a>
                <a class="app-nav-link @(settingsActive ? "active" : null)"
                   aria-current="@(settingsActive ? "page" : null)"
                   asp-controller="WorkspaceSettings" asp-action="LegalIdentity">
                    Paramètres
                </a>
            </nav>

            <div class="app-account mt-auto">
                @if (!string.IsNullOrWhiteSpace(User.Identity?.Name))
                {
                    <div class="app-account-identity">
                        <span class="app-account-label">Connecté</span>
                        <span class="app-account-name">@User.Identity.Name</span>
                    </div>
                }
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button class="btn btn-outline-secondary w-100" type="submit">Se déconnecter</button>
                </form>
            </div>
        </div>
    </div>
}
else
{
    <header class="public-header">
        <div class="container d-flex align-items-center justify-content-between gap-3">
            <a class="app-brand" asp-controller="Home" asp-action="Index">Alouva</a>
            <a class="btn btn-sm btn-outline-primary px-3" asp-controller="Account" asp-action="Login">Se connecter</a>
        </div>
    </header>
    @if (isLanding)
    {
        <main class="landing-main">@RenderBody()</main>
    }
    else
    {
        <main class="container py-5">@RenderBody()</main>
    }
}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
