@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var customersActive = controller is "Customers" or "Quotes" or "Invoices";
    var settingsActive = controller == "WorkspaceSettings";
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Freecrmlance</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@if (User.Identity?.IsAuthenticated == true)
{
    <div class="app-shell">
        <aside class="app-sidebar">
            <div class="app-sidebar-top">
                <a class="app-brand" asp-controller="Customers" asp-action="Index">
                    <span class="app-brand-mark" aria-hidden="true">F</span>
                    <span><strong>Freecrmlance</strong><small>Mon activité</small></span>
                </a>
                <nav class="app-nav" aria-label="Navigation principale">
                    <a class="app-nav-link @(customersActive ? "active" : null)" asp-controller="Customers" asp-action="Index">
                        <span class="app-nav-icon" aria-hidden="true">⌂</span><span>Clients</span>
                    </a>
                    <a class="app-nav-link @(settingsActive ? "active" : null)" asp-controller="WorkspaceSettings" asp-action="LegalIdentity">
                        <span class="app-nav-icon" aria-hidden="true">⚙</span><span>Paramètres</span>
                    </a>
                </nav>
            </div>
            <div class="app-sidebar-footer">
                <div class="app-user">
                    <span class="app-user-avatar" aria-hidden="true">@(User.Identity?.Name?.FirstOrDefault().ToString().ToUpperInvariant() ?? "U")</span>
                    <span class="app-user-copy"><strong>Mon espace</strong><small>@User.Identity?.Name</small></span>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button class="btn btn-quiet w-100" type="submit">Se déconnecter</button>
                </form>
            </div>
        </aside>
        <div class="app-main">
            <header class="app-mobile-header">
                <a class="app-brand" asp-controller="Customers" asp-action="Index"><span class="app-brand-mark" aria-hidden="true">F</span><strong>Freecrmlance</strong></a>
                <button class="btn btn-quiet btn-sm" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileNav" aria-controls="mobileNav">Menu</button>
            </header>
            <main class="app-content">@RenderBody()</main>
            <footer class="app-footer">Freecrmlance · Votre activité, simplement.</footer>
        </div>
    </div>
    <div class="offcanvas offcanvas-start" tabindex="-1" id="mobileNav" aria-labelledby="mobileNavLabel">
        <div class="offcanvas-header"><div class="app-brand"><span class="app-brand-mark">F</span><h2 class="offcanvas-title h6 mb-0" id="mobileNavLabel">Freecrmlance</h2></div><button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Fermer"></button></div>
        <div class="offcanvas-body d-flex flex-column">
            <nav class="app-nav mb-4">
                <a class="app-nav-link @(customersActive ? "active" : null)" asp-controller="Customers" asp-action="Index">Clients</a>
                <a class="app-nav-link @(settingsActive ? "active" : null)" asp-controller="WorkspaceSettings" asp-action="LegalIdentity">Paramètres</a>
            </nav>
            <form asp-controller="Account" asp-action="Logout" method="post" class="mt-auto"><button class="btn btn-quiet w-100" type="submit">Se déconnecter</button></form>
        </div>
    </div>
}
else
{
    <header class="public-header"><div class="container"><a class="app-brand" asp-controller="Home" asp-action="Index"><span class="app-brand-mark" aria-hidden="true">F</span><strong>Freecrmlance</strong></a></div></header>
    <main class="container py-5">@RenderBody()</main>
}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
