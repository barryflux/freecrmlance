@model Freecrmlance.Web.Models.Audits.CreateAuditViewModel
@{ViewData["Title"]="Nouvel audit";}
<h1 class="h2 mb-4">Nouvel audit</h1><form method="post" class="card card-body"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="CustomerId" class="form-label">Client</label><select asp-for="CustomerId" asp-items="Model.Customers" class="form-select"><option value="">Choisir un client</option></select></div><div class="mb-3"><label asp-for="TemplateId" class="form-label">Modèle</label><select asp-for="TemplateId" asp-items="Model.Templates" class="form-select"><option value="">Choisir un modèle</option></select></div><div class="mb-3"><label asp-for="Title" class="form-label">Titre personnalisé (optionnel)</label><input asp-for="Title" class="form-control" /></div><div class="mb-3"><label asp-for="Description" class="form-label">Description personnalisée (optionnelle)</label><textarea asp-for="Description" class="form-control" rows="3"></textarea></div><div><button class="btn btn-primary">Créer l'audit</button> <a class="btn btn-link" asp-action="Index">Annuler</a></div></form>
