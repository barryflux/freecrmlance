@model Freecrmlance.Application.Audits.AuditDto
@{ViewData["Title"]=Model.Reference;}
<div class="page-header d-flex justify-content-between align-items-start gap-3"><div><div class="text-body-secondary">@Model.Reference · @Model.Status</div><h1 class="h2 mb-1">@Model.Title</h1>@if(Model.Description is not null){<p class="text-body-secondary">@Model.Description</p>}<div class="small text-body-secondary">Progression : @Model.ProgressPercent %</div></div><a class="btn btn-primary" asp-action="Workspace" asp-route-id="@Model.Id">Réaliser l'audit</a></div>
@foreach(var auditSection in Model.Sections){<section class="card mb-3"><div class="card-body"><h2 class="h5">@auditSection.Title</h2>@if(auditSection.Description is not null){<p class="text-body-secondary">@auditSection.Description</p>}<ol class="mb-0">@foreach(var item in auditSection.Items){<li class="mb-2"><strong>@item.Label</strong> <span class="badge text-bg-light">@item.ResponseType</span>@if(item.IsRequired){<span class="text-danger ms-1">obligatoire</span>}@if(item.Description is not null){<div class="small text-body-secondary">@item.Description</div>}</li>}</ol></div></section>}
