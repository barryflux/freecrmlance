@model Freecrmlance.Application.Audits.AuditDto
@{ViewData["Title"]=Model.Reference;}
<div class="page-header"><div><div class="text-body-secondary">@Model.Reference · @Model.Status</div><h1 class="h2 mb-1">@Model.Title</h1>@if(Model.Description is not null){<p class="text-body-secondary">@Model.Description</p>}</div></div>
@foreach(var section in Model.Sections){<section class="card mb-3"><div class="card-body"><h2 class="h5">@section.Title</h2>@if(section.Description is not null){<p class="text-body-secondary">@section.Description</p>}<ol class="mb-0">@foreach(var item in section.Items){<li class="mb-2"><strong>@item.Label</strong> <span class="badge text-bg-light">@item.ResponseType</span>@if(item.IsRequired){<span class="text-danger ms-1">obligatoire</span>}@if(item.Description is not null){<div class="small text-body-secondary">@item.Description</div>}</li>}</ol></div></section>}
