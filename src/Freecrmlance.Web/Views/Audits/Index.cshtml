@model IReadOnlyList<Freecrmlance.Application.Audits.AuditDto>
@{ViewData["Title"]="Audits";}
<div class="page-header d-flex justify-content-between align-items-center gap-3"><div><h1 class="h2 mb-1">Audits</h1><p class="text-body-secondary mb-0">Audits créés à partir de vos modèles.</p></div><div class="d-flex gap-2"><a class="btn btn-outline-secondary" asp-controller="AuditTemplates" asp-action="Index">Modèles</a><a class="btn btn-primary" asp-action="Create">Nouvel audit</a></div></div>
@if(Model.Count==0){<div class="empty-state"><h2 class="h5">Aucun audit</h2><p class="text-body-secondary">Créez un audit depuis un modèle.</p></div>}else{<div class="table-responsive"><table class="table align-middle"><thead><tr><th>Référence</th><th>Titre</th><th>Statut</th><th>Créé le</th></tr></thead><tbody>@foreach(var x in Model){<tr><td><a asp-action="Details" asp-route-id="@x.Id">@x.Reference</a></td><td>@x.Title</td><td>@x.Status</td><td>@x.CreatedAtUtc.ToLocalTime().ToString("g")</td></tr>}</tbody></table></div>}
