<script>
(()=>{const sections=document.querySelector("#sections");const types={"YesNo":0,"CompliantNonCompliant":1,"Text":2,"LongText":3,"Number":4,"Rating":5,"SingleChoice":6,"MultipleChoice":7};
function reindex(){[...sections.querySelectorAll("[data-section]")].forEach((s,si)=>{s.querySelector("[data-section-number]").textContent=si+1;[...s.querySelectorAll("input,textarea,select")].forEach(el=>{if(el.name)el.name=el.name.replace(/Sections\[\d+\]/,`Sections[${si}]`)});[...s.querySelectorAll("[data-item]")].forEach((it,ii)=>[...it.querySelectorAll("input,textarea,select")].forEach(el=>{if(el.name)el.name=el.name.replace(/Items\[\d+\]/,`Items[${ii}]`)}));});}
function item(si,ii){return `<div class="border rounded p-3 mb-2" data-item><div class="d-flex justify-content-between"><strong>Critère</strong><button type="button" class="btn btn-sm btn-link text-danger" data-remove-item>Retirer</button></div><div class="mb-2"><label class="form-label">Question / critère</label><input class="form-control" name="Sections[${si}].Items[${ii}].Label"/></div><div class="row g-2"><div class="col-md-5"><label class="form-label">Type de réponse</label><select class="form-select" name="Sections[${si}].Items[${ii}].ResponseType"><option value="0">Oui / Non</option><option value="1">Conforme / Non conforme</option><option value="2">Texte</option><option value="3">Texte long</option><option value="4">Nombre</option><option value="5">Note</option><option value="6">Choix unique</option><option value="7">Choix multiple</option></select></div><div class="col-md-5"><label class="form-label">Options (une par ligne)</label><textarea class="form-control" name="Sections[${si}].Items[${ii}].Options" rows="2"></textarea></div><div class="col-md-2 d-flex align-items-end"><div class="form-check mb-2"><input type="checkbox" class="form-check-input" value="true" name="Sections[${si}].Items[${ii}].IsRequired"/><label class="form-check-label">Obligatoire</label></div></div></div><div class="mt-2"><label class="form-label">Aide / consigne</label><textarea class="form-control" name="Sections[${si}].Items[${ii}].Description" rows="2"></textarea></div></div>`;}
function section(si){return `<section class="card mb-3 audit-section" data-section><div class="card-body"><div class="d-flex justify-content-between"><h2 class="h5">Section <span data-section-number>${si+1}</span></h2><button type="button" class="btn btn-sm btn-outline-danger" data-remove-section>Retirer</button></div><div class="mb-2"><label class="form-label">Titre</label><input class="form-control" name="Sections[${si}].Title"/></div><div class="mb-3"><label class="form-label">Description</label><textarea class="form-control" name="Sections[${si}].Description" rows="2"></textarea></div><div data-items>${item(si,0)}</div><button type="button" class="btn btn-sm btn-outline-primary" data-add-item>+ Ajouter un critère</button></div></section>`;}
document.querySelector("#addSection").onclick=()=>{sections.insertAdjacentHTML("beforeend",section(sections.querySelectorAll("[data-section]").length));};
sections.onclick=e=>{const s=e.target.closest("[data-section]");if(e.target.matches("[data-add-item]")){const box=s.querySelector("[data-items]");box.insertAdjacentHTML("beforeend",item([...sections.children].indexOf(s),box.querySelectorAll("[data-item]").length));}if(e.target.matches("[data-remove-item]")){e.target.closest("[data-item]").remove();reindex();}if(e.target.matches("[data-remove-section]")){s.remove();reindex();}};
})();
</script>